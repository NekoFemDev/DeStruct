# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Decompiler output (default -o target for all `destruct` subcommands
# - see COMMANDS.md; also removed by `make clean`)
output/

# Transient enhancement-test output directories created by test scripts
enhanced_output_*/
test_output_*/
test_error_output/

# Keep the internal/output package used by the Flutter/libapp.so analyzer.
!internal/flutter/unflutter-0.5.9/internal/output/

# Compiled top-level binaries (build products of `make build` / a
# manual `go build -o <name> ./cmd/...` at the repo root) - not the
# cmd/*/main.go sources themselves, which are tracked.
/destruct
/lifttest
/lvtest

# test/ holds real sample binaries (.dex/.jar/.so/ELF fixtures) used
# by the test suite and for manual decompiler validation against known
# source - tracked despite the generic binary-artifact rules above
# (*.so, ...), which would otherwise silently exclude them.
test/
test/**

# ...except a reference source tree's own local CMake build output
# under test/ (compiler-ABI probes, CMakeCache.txt with absolute local
# paths) - regenerable build artifacts, not source or a fixture in
# their own right.
test/il2cpp_memory_dumper_main/build/

# Bundled Capstone (downloaded source, not tracked in git)
# Versioned source dirs plus the stable capstone-src symlink that
# fetch-capstone.sh / make maintains (points at the pinned version).
capstone-*/
capstone-src

# Bundled Capstone build artifacts
third_party/capstone/build/

# Local decompiler run artifacts at the repo root - not source and not
# the tracked test fixtures under test/ (see the test/** note above).
/test_output/
/classes.dex
/global-metadata.dat
# NestLoader release bundle + its extracted directory
/NestLoader*

# Per-bug reproduction/hypothesis logs (local working artifacts)
/fix-logs/

# Local reference checkout used only to regenerate the Hermes opcode
# tables (see internal/hermes/opcodes/data/build_data.py). The derived
# tables are tracked; the upstream clone itself is not. Its Apache-2.0
# licence is vendored at third_party/hbctool/LICENSE.Apache-2.0.
/hbctool/

# Local release/snapshot archive made at the repo root.
/DeStruct.zip

# Large local IL2CPP sample files used for manual validation. The test
# suite does not depend on them; regenerate/download rather than tracking
# ~100 MB of fixture data.
/internal/il2cpp/testdata/

# Dumps
*_dump/
*-dump/
dump_*/
dump-*/
dump/

# Local generated decompilation output and sample ELF used for manual
# validation; not part of the source tree.
/assets_decompile/
/quazar_arm64
